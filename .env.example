# Copy to .env.local and set a long random value.
# Without this the /admin area stays closed to everyone.
ADMIN_PASSWORD=

# Supabase Auth — learner sign-up and sign-in (email + Google).
# Both are public values that ship to the browser; find them in the Supabase
# dashboard under Project Settings → API. Never put the secret/service-role key
# here. Without these, sign-in stays switched off and lessons remain open.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
