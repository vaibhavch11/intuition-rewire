{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intuition-rewire",
  // edge-worker.js wraps OpenNext's .open-next/worker.js with an edge cache.
  "main": "edge-worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Serve .html files at their exact path (no redirect to /name), as
    // Google Search Console's verification file requires.
    "html_handling": "none",
    // Videos go through edge-worker.js, which answers byte-range requests:
    // Safari and iPhones need them to stream and autoplay a video.
    "run_worker_first": ["/videos/*"]
  },
  // The site's own domain (SITE_URL in src/lib/seo.ts); www and workers.dev
  // redirect to it in src/proxy.ts.
  "routes": [
    { "pattern": "intuitionrewire.com", "custom_domain": true },
    { "pattern": "www.intuitionrewire.com", "custom_domain": true }
  ],
  // Kept on so old workers.dev links (and its Search Console property) still
  // resolve and redirect; listing routes would otherwise switch these off.
  "workers_dev": true,
  "preview_urls": true,
  "r2_buckets": [
    {
      "bucket_name": "intuition-rewire-storage",
      "binding": "CONTENT_BUCKET"
    }
  ],
  // The deployment id, so edge-cached pages never outlive the scripts they load.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true
  }
}
