{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intuition-rewire",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Serve .html files at their exact path (no redirect to /name), as
    // Google Search Console's verification file requires.
    "html_handling": "none"
  },
  "r2_buckets": [
    {
      "bucket_name": "intuition-rewire-storage",
      "binding": "CONTENT_BUCKET"
    }
  ],
  "observability": {
    "enabled": true
  }
}
