            "text": "3. Loops work:\n   i = 0, 1, 2, …",
            "fontSize": 20,
            "fontFamily": 8,
            "textAlign": "left",
            "verticalAlign": "middle",
            "containerId": "Aeo9281b92CtzL_ASd-kD",
            "originalText": "3. Loops work:\n   i = 0, 1, 2, …",
            "autoResize": true,
            "lineHeight": 1.25
          }
        ],
