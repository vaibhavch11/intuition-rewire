            "locked": false,
            "type": "text",
            "text": "one pass, O(N), no extra memory",
            "fontSize": 16,
            "fontFamily": 1,
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "one pass, O(N), no extra memory",
            "autoResize": true,
