          {
            "id": "aM_5na9FgGd2pUA",
            "x": 450,
            "y": 258,
            "width": 570.35,
            "height": 21.25,
            "angle": 0,
            "strokeColor": "#3525cd",
            "backgroundColor": "transparent",
            "fillStyle": "solid",
            "strokeWidth": 2,
            "strokeStyle": "solid",
            "roughness": 1,
            "opacity": 100,
            "groupIds": [],
            "frameId": null,
            "index": "a12",
