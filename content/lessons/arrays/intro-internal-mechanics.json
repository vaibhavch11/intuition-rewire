      "src": "/drawings/e472a216-152d-43de-b605-1e7ab04f2378.svg",
      "alt": "Memory addresses increasing by four bytes per slot, with the formula base plus index times size",
      "caption": "The machine computes the address instead of searching for it",
      "width": 900,
      "height": 330,
