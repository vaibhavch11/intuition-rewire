            "text": "6 >= 1, 5 >= 2, 3 >= 3, but 1 < 4  ->  h = 3",
            "fontSize": 17,
            "fontFamily": 8,
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "6 >= 1, 5 >= 2, 3 >= 3, but 1 < 4  ->  h = 3",
