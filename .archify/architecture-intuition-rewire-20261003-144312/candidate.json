    {
      "dot": "cyan",
      "title": "Public vs signed in",
      "items": [
        "Home, course list and course pages are public",
        "Every /dsa/<course>/<lesson> page needs a Supabase session",
        "The proxy redirects first; the page re-checks as a backstop"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where lesson content lives",
      "items": [
        "R2 is the source of truth once deployed",
        "Lessons and curriculum edits read disk first in next dev, then R2",
        "Drawings ship as static assets; ones saved after a deploy are served from R2"
      ]
    },
    {
      "dot": "violet",
      "title": "In the browser",
      "items": [
        "Progress and reactions stay in localStorage, never on a server",
        "Each dry-run simulator is its own lazy-loaded JS chunk"
      ]
    }
