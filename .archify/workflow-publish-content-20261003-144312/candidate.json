  "cards": [
    {
      "dot": "emerald",
      "title": "Live edits",
      "items": [
        "A save in /admin writes R2 and shows on the next request",
        "Removed lessons can't be saved back into existence"
      ]
    },
    {
      "dot": "cyan",
      "title": "Releases",
      "items": [
        "Deploy ships code and committed drawings as static assets",
        "seed-content only uploads keys that R2 doesn't have yet"
      ]
    },
    {
      "dot": "amber",
      "title": "Who wins",
      "items": [
        "A lesson edited live in /admin is never overwritten by the seed",
        "Replacing it means a deliberate, separate upload"
      ]
    }
  ]
